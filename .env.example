# ─────────────────────────────────────────────────────────────────────────────
# DEV ENV TEMPLATE — root .env (loaded by docker compose)
# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env` (gitignored) and fill in real values. Docker compose reads
# `.env` automatically; host-run Playwright (e2e) also reads it via dotenv.
# Single source of truth — no `.env.local` split.
#
# Phase 18d: we run against a real Supabase cloud project (`codetutor-dev`) in
# dev, CI, and E2E. There is no local Supabase stack anymore. Contributors
# without project creds should reach out to the repo owner — see
# docs/DEVELOPMENT.md → "First-time setup".
#
# Every value here is 12-factor config; nothing is hardcoded in source.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend ──────────────────────────────────────────────────────────────────
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Name of the pre-built polyglot runner image.
RUNNER_IMAGE=codetutor-ai-runner:latest

# Per-session idle timeout + how often the sweeper runs. Both in milliseconds.
SESSION_IDLE_TIMEOUT_MS=120000
SESSION_SWEEP_INTERVAL_MS=45000

# Per-run resource limits for spawned runner containers.
RUNNER_MEMORY_BYTES=536870912
RUNNER_NANO_CPUS=1000000000
RUN_TIMEOUT_MS=10000

# ── Supabase (codetutor-dev cloud project) ───────────────────────────────────
# From Supabase dashboard → Project Settings → Data API:
#   Project URL → SUPABASE_URL
# From Supabase dashboard → Project Settings → API Keys:
#   Publishable key → SUPABASE_ANON_KEY / VITE_SUPABASE_ANON_KEY
#   Secret key      → SUPABASE_SERVICE_ROLE_KEY (sensitive, server-side only)
# From Supabase dashboard → Project Settings → Database → Connection string →
#   Transaction pooler (port 6543), password filled in → DATABASE_URL
#
# JWT verification is asymmetric (JWKS). No shared secret env var.
SUPABASE_URL=https://<your-dev-project-ref>.supabase.co
# E2E helper (Playwright) reads SUPABASE_ANON_KEY without the VITE_ prefix.
SUPABASE_ANON_KEY=<your-dev-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<your-dev-secret-key>
DATABASE_URL=postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── Frontend (Vite dev server inside docker compose) ─────────────────────────
# When the frontend container runs `vite dev`, these values flow via compose
# env interpolation. For host-run Vite (`cd frontend && npm run dev`), Vite
# instead reads `frontend/.env.development.local` — populate that file too.
VITE_BACKEND_URL=http://backend:4000
VITE_SUPABASE_URL=https://<your-dev-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-dev-publishable-key>

# ── BYOK (Bring-Your-Own-Key) encryption ─────────────────────────────────────
# Master key(s) used to encrypt each user's saved OpenAI API key at rest in
# `user_preferences` (AES-256-GCM envelope, per-row random nonce, per-user
# AAD binding). Must be a 32-byte value, base64-encoded. Generate with:
#     openssl rand -base64 32
# Required — the backend refuses to boot without one.
#
# Phase 26 rotation support — multiple versions can coexist:
#   BYOK_ENCRYPTION_KEY        → V1 (legacy single-key shape; backward-compat)
#   BYOK_ENCRYPTION_KEY_V2     → V2 (set when rotating to a fresh key)
#   BYOK_ENCRYPTION_KEY_V3     → V3 (and so on, any positive integer)
# BYOK_CURRENT_VERSION (default 1) selects which version new writes encrypt
# under. Decrypts pick automatically by reading the version byte from the
# ciphertext. To rotate: add the V_n+1 var, deploy, bump CURRENT_VERSION,
# run the re-encrypt sweep, then drop the old V_n var.
BYOK_ENCRYPTION_KEY=<run `openssl rand -base64 32` and paste the output>
# BYOK_ENCRYPTION_KEY_V2=
# BYOK_CURRENT_VERSION=1

# ── Local OpenAI key (optional fallback; primary path is BYOK above) ─────────
# OPENAI_API_KEY=sk-...

# ── Prometheus `/api/metrics` auth (optional) ────────────────────────────────
# If set, /api/metrics requires `Authorization: Bearer <METRICS_TOKEN>`.
# If unset, /api/metrics is loopback-only (127.0.0.1 / ::1). Leave blank
# for dev; set to a random string in prod when wiring an external scraper.
#   openssl rand -base64 32
# METRICS_TOKEN=

# ── Release 0A: non-counting crawler share previews ─────────────────────────
# The SWA managed Function signs each metadata lookup with this dedicated
# 32-byte HMAC key. It is not a user credential and grants access only to the
# minimal /api/internal/share-previews/:token DTO. Generate a dev-only key:
#   openssl rand -base64 32
# Production values live in Azure Key Vault + SWA API application settings.
# SHARE_PREVIEW_HMAC_CURRENT_KEY_ID=dev-v1
# SHARE_PREVIEW_HMAC_CURRENT_SECRET=
# SHARE_PREVIEW_HMAC_PREVIOUS_KEY_ID=
# SHARE_PREVIEW_HMAC_PREVIOUS_SECRET=
# SHARE_PREVIEW_DISABLED=0

# B3 model-routing activation/rollback. Non-production 0 keeps the evaluated
# Mini route for progressed check-ins. Production is safe-off when missing and
# requires an explicit 0 under the recorded rollout protocol; 1 returns to Nano.
# SHARE_PREVIEW_RATE_LIMIT_MAX=600

# ── Phase 20-P4: Free AI tier (operator-funded daily allowance) ──────────────
# When ENABLE_FREE_TIER=1, users without a BYOK key can tutor-chat on the
# operator's OpenAI key for FREE_TIER_DAILY_QUESTIONS/day. Multiple layered
# $ caps bound the blast radius of any bypass. PLATFORM_OPENAI_API_KEY is
# required whenever ENABLE_FREE_TIER=1 — assertConfigValid refuses to boot
# otherwise. Leave the key empty for BYOK-only dev.
ENABLE_FREE_TIER=0
FREE_TIER_DAILY_QUESTIONS=30
FREE_TIER_DAILY_USD_PER_USER=0.10
FREE_TIER_LIFETIME_USD_PER_USER=1.00
FREE_TIER_DAILY_USD_CAP=2.00
# PLATFORM_OPENAI_API_KEY=sk-...

# ── Phase 24B: ACI hybrid burst overflow ─────────────────────────────────────
# When local Docker session count hits MAX_SESSIONS_GLOBAL (14), new
# sessions spill over to Azure Container Instances. Quiet days = $0 ACI
# cost. Each ACI session bills ~$0.053/hr while running and is destroyed
# the instant the user's session ends. ACI_DAILY_USD_CAP is the hard
# operator brake — once exceeded for the UTC day, ACI overflow returns
# 503 instead of spawning more containers. Resets at UTC midnight.
#
# Defaults below assume dev (no Azure resources). Effective enabled state
# = (ENABLE_ACI_OVERFLOW != "0") AND (Azure config present). With the
# Azure-target vars empty the factory logs a warning and falls back to
# local-only mode — safe for local development.
ENABLE_ACI_OVERFLOW=1
ACI_DAILY_USD_CAP=20
ACI_MAX_OVERFLOW=36
ACI_COLD_START_TIMEOUT_MS=30000
ACI_SIDECAR_PORT=5757
# Azure resource targets — only set in prod (via Key Vault → refresh-env).
# AZURE_SUBSCRIPTION_ID=
# AZURE_RG=codetutor-ai-prod-rg
# AZURE_LOCATION=eastus2
# ACI_SUBNET_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.Network/virtualNetworks/<vnet>/subnets/<aci-subnet>
# ACI_RUNNER_IMAGE=ghcr.io/msrivas-7/codetutor-runner@sha256:...

# ── Dev-user seeder password (codetutor-dev only) ────────────────────────────
# Shared password for users seeded by `backend/scripts/seed-dev-users.ts`
# (user1@test.com … user5@test.com). Never commit the real value. Rotate by
# changing this and re-running the seed script.
DEV_SEED_PASSWORD=<pick-a-strong-dev-password>
